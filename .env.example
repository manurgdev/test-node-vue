# Configuración del servidor
PORT=3000
NODE_ENV=development

# Configuración de MongoDB - Descomentar la opción deseada

# Opción 1: MongoDB en Docker (cuando usas docker-compose)
MONGODB_DOCKER_URI=mongodb://admin:password@mongodb:27017/app?authSource=admin

# Opción 2: MongoDB local (cuando tienes MongoDB instalado localmente)
# MONGODB_LOCAL_URI=mongodb://localhost:27017/app

# Opción 3: MongoDB Atlas o cualquier otra instancia remota
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/app?retryWrites=true&w=majority

# La aplicación intenta conectarse en este orden: MONGODB_URI, MONGODB_DOCKER_URI, MONGODB_LOCAL_URI 